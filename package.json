{
  "name": "dockslot",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source dock scheduling and real-time recovery engine",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web,worker \"npm run dev -w @dockslot/api\" \"npm run dev -w @dockslot/web\" \"npm run dev -w @dockslot/worker\"",
    "build": "npm run typecheck && npm run build -w @dockslot/web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/engine.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx packages/db/src/cli.ts migrate",
    "db:seed": "tsx packages/db/src/cli.ts seed",
    "demo:local": "tsx scripts/local-demo.ts",
    "local": "tsx scripts/local-demo.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.2",
    "argon2": "^0.44.0",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "^6.0.0",
    "luxon": "^3.7.2",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.15.5",
    "concurrently": "^9.2.1",
    "embedded-postgres": "^18.0.0-beta.15",
    "fast-check": "^4.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
